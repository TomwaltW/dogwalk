/* miniprogram/pages/spot/spot.wxss */

.banner {
  background: #fff2f0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
}

.hero {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}

.spot-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
}

.peak {
  display: block;
  font-size: 24rpx;
  margin-top: 6rpx;
}

.count {
  display: block;
  font-size: 28rpx;
  margin-top: 16rpx;
  color: #8a8a8a;
}

.count-on {
  color: #12885a;
  font-weight: 500;
}

.state {
  padding: 80rpx 24rpx;
  text-align: center;
}

.row {
  display: flex;
  align-items: flex-start;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 20rpx;
  background: #e8e8e8;
}

.avatar-blank {
  background: #e8e8e8;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.nickname {
  font-size: 30rpx;
  font-weight: 500;
}

.time {
  font-size: 24rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.dogs {
  display: block;
  font-size: 26rpx;
  color: #1a6fd4;
  margin-top: 6rpx;
}

.note {
  display: block;
  font-size: 24rpx;
  margin-top: 6rpx;
}

.qr {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 24rpx;
  text-align: center;
}

.qr-img {
  width: 280rpx;
  height: 280rpx;
}

.qr-tip {
  display: block;
  font-size: 24rpx;
  margin-top: 12rpx;
}

/* 给固定在底部的按钮腾位置 */
.footer-space {
  height: 160rpx;
}

.cta {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 32rpx;
  border-radius: 48rpx;
}
