/* miniprogram/pages/me/me.wxss —— 只写本页特有的,主色与基础类用 app.wxss 的变量 */
.head {
  padding: 32rpx 0 40rpx;
  text-align: center;
}

.head .avatar {
  width: 140rpx;
  height: 140rpx;
  display: inline-flex;
  font-size: 56rpx;
}

.nickname {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.link {
  color: var(--c-primary-deep);
  font-size: 26rpx;
  margin-left: 24rpx;
}

.dog {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--c-line);
}

.dog:last-child {
  border-bottom: none;
}

.dog-text {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.dog-name {
  font-size: 30rpx;
}

.lost-flag {
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: var(--c-danger-soft);
  color: var(--c-danger);
  font-size: 22rpx;
}

.sub {
  font-size: 24rpx;
}

.dog-ops {
  display: flex;
  flex-shrink: 0;
}

.walk {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--c-line);
}

.walk:last-child {
  border-bottom: none;
}

.walk.off .walk-title {
  color: var(--c-muted);
  text-decoration: line-through;
}

.walk-main {
  flex: 1;
  min-width: 0;
}

.walk-title {
  font-size: 28rpx;
}

.status {
  flex-shrink: 0;
  margin-left: 20rpx;
  font-size: 24rpx;
  color: var(--c-primary-deep);
}
