<view class="container">
  <view class="head">
    <block wx:if="{{logged}}">
      <image wx:if="{{user.avatarFileID}}" class="avatar" src="{{user.avatarFileID}}" mode="aspectFill" />
      <view wx:else class="avatar avatar-blank">🙂</view>
      <view class="nickname">{{user.nickname || '狗主人'}}</view>
    </block>
    <button wx:else class="btn-primary" bindtap="onLogin">登录</button>
  </view>

  <view wx:if="{{errMsg}}" class="banner-err">{{errMsg}}</view>

  <!-- 我的狗 -->
  <view class="card">
    <view class="row-head">
      <text class="section-title">我的狗</text>
      <text class="link" bindtap="onAddDog">+ 加一只</text>
    </view>

    <view wx:if="{{loading}}" class="muted">加载中…</view>
    <view wx:elif="{{dogs.length === 0}}" class="empty">{{dogsEmptyText}}</view>

    <view wx:for="{{dogs}}" wx:key="_id" class="dog">
      <image wx:if="{{item.avatarFileID}}" class="avatar" src="{{item.avatarFileID}}" mode="aspectFill" />
      <view wx:else class="avatar avatar-blank">🐶</view>
      <view class="dog-text">
        <view class="dog-name">
          {{item.name}}
          <text wx:if="{{item.lostMode}}" class="lost-flag">走失中</text>
        </view>
        <view class="muted sub">{{item.sizeText}}{{item.tagsText ? ' · ' + item.tagsText : ''}}</view>
      </view>
      <view class="dog-ops">
        <text class="link" data-dog-id="{{item._id}}" bindtap="onEditDog">编辑</text>
        <text class="link" data-dog-id="{{item._id}}" bindtap="onOpenTag">身份牌</text>
      </view>
    </view>
  </view>

  <!-- 我发起的约遛 -->
  <view class="card">
    <view class="section-title">我发起的约遛</view>
    <view wx:if="{{walksLoading}}" class="muted">加载中…</view>
    <view wx:elif="{{hostedWalks.length === 0}}" class="empty">{{hostedEmptyText}}</view>
    <view
      wx:for="{{hostedWalks}}"
      wx:key="walkId"
      class="walk {{item.cancelled ? 'off' : ''}}"
      data-walk-id="{{item.walkId}}"
      bindtap="onOpenWalk"
    >
      <view class="walk-main">
        <view class="walk-title">{{item.parkName}} · {{item.timeText}}</view>
        <view class="muted sub">{{item.dogCount}} 只狗{{item.maxDogs ? ' / 上限 ' + item.maxDogs : ''}}{{item.note ? ' · ' + item.note : ''}}</view>
      </view>
      <text class="status">{{item.statusText}}</text>
    </view>
  </view>

  <!-- 我参加的约遛 -->
  <view class="card">
    <view class="section-title">我参加的约遛</view>
    <view wx:if="{{walksLoading}}" class="muted">加载中…</view>
    <view wx:elif="{{joinedWalks.length === 0}}" class="empty">{{joinedEmptyText}}</view>
    <view
      wx:for="{{joinedWalks}}"
      wx:key="walkId"
      class="walk {{item.cancelled ? 'off' : ''}}"
      data-walk-id="{{item.walkId}}"
      bindtap="onOpenWalk"
    >
      <view class="walk-main">
        <view class="walk-title">{{item.parkName}} · {{item.timeText}}</view>
        <view class="muted sub">{{item.dogCount}} 只狗{{item.note ? ' · ' + item.note : ''}}</view>
      </view>
      <text class="status">{{item.statusText}}</text>
    </view>
  </view>
</view>
<privacy-popup id="privacy-popup" />
