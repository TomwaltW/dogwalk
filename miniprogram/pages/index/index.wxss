/* miniprogram/pages/index/index.wxss */

.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 8rpx 0 24rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
}

.sub {
  display: block;
  font-size: 24rpx;
  margin-top: 4rpx;
}

.link {
  color: #1a6fd4;
  font-size: 28rpx;
  padding: 8rpx 0 8rpx 24rpx;
}

.banner {
  background: #fff2f0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
}

.state {
  padding: 80rpx 0;
  text-align: center;
}

.card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
}

.card-hover {
  background: #f0f0f0;
}

.card-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.spot-name {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
}

.peak {
  display: block;
  font-size: 24rpx;
  margin-top: 6rpx;
}

.card-side {
  text-align: right;
  flex-shrink: 0;
}

.live {
  display: block;
  font-size: 26rpx;
  color: #8a8a8a;
}

.live-on {
  color: #12885a;
  font-weight: 500;
}

.regular {
  display: block;
  font-size: 22rpx;
  margin-top: 6rpx;
}
