/* miniprogram/pages/checkin/checkin.wxss */

.banner {
  background: #fff2f0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
}

.block {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.state {
  padding: 40rpx 0;
  text-align: center;
}

.dog-list {
  display: flex;
  flex-wrap: wrap;
}

.dog {
  width: 140rpx;
  text-align: center;
  padding: 16rpx 0;
  margin: 0 16rpx 16rpx 0;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.dog-on {
  border-color: #12885a;
  background: #eef8f3;
}

.dog-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e8e8e8;
}

.dog-name {
  display: block;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.note {
  font-size: 28rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.counter {
  display: block;
  text-align: right;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.hint {
  display: block;
  font-size: 24rpx;
  padding: 0 8rpx 32rpx;
}

.cta {
  border-radius: 48rpx;
}
