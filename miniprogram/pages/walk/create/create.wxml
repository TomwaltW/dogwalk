<!-- 发起约遛 —— owner: T10。能在本地判死的都不发请求,errMsg 由 create.js 的 validate 给。 -->
<view class="container">
  <view wx:if="{{errMsg}}" class="banner-err">{{errMsg}}</view>

  <view wx:if="{{loading}}" class="empty">正在准备…</view>

  <view wx:else>
    <view class="field">
      <text class="label">去哪个公园</text>
      <picker mode="selector" range="{{parkNames}}" value="{{parkIndex}}" bindchange="onParkChange">
        <view class="input picker-value {{parkIndex < 0 ? 'placeholder' : ''}}">
          {{parkIndex >= 0 ? parkNames[parkIndex] : '选一个公园'}}
        </view>
      </picker>
    </view>

    <view class="field">
      <text class="label">什么时候</text>
      <view class="time-row">
        <picker mode="date" start="{{minDate}}" value="{{date}}" bindchange="onDateChange">
          <view class="input picker-value">{{date ? date : '选日期'}}</view>
        </picker>
        <picker mode="time" value="{{time}}" bindchange="onTimeChange">
          <view class="input picker-value">{{time ? time : '选时间'}}</view>
        </picker>
      </view>
    </view>

    <view class="field">
      <text class="label">带哪几只狗</text>
      <view wx:if="{{!dogs.length}}" class="empty">还没有狗狗档案,先去「我的」加一只</view>
      <view wx:else class="chips">
        <view
          class="chip {{item.selected ? 'chip-on' : ''}}"
          wx:for="{{dogs}}"
          wx:key="dogId"
          data-id="{{item.dogId}}"
          bindtap="onToggleDog"
        >{{item.name}}<text class="chip-meta">{{item.sizeText}}</text></view>
      </view>
    </view>

    <view class="field">
      <text class="label">说一句(选填,最多 {{noteMax}} 字)</text>
      <textarea
        class="textarea"
        value="{{note}}"
        maxlength="{{noteMax}}"
        placeholder="比如:带球来,玩半小时"
        bindinput="onNoteInput"
      />
    </view>

    <view class="field row">
      <text class="label">最多几只狗(含自己的)</text>
      <view class="stepper">
        <view class="stepper-btn" bindtap="onMaxDogsMinus">−</view>
        <text class="stepper-value">{{maxDogs}}</text>
        <view class="stepper-btn" bindtap="onMaxDogsPlus">＋</view>
      </view>
    </view>

    <button class="btn-primary submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">
      发起约遛
    </button>
    <view class="back-link" bindtap="onBackToList">先不发,回列表看看</view>
  </view>
</view>

<privacy-popup id="privacy-popup" />
