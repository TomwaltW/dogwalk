/* miniprogram/pages/walk/create/create.wxss —— 页面样式只写在这,主色与基础类用 app.wxss 的变量 */
@import "../walk.wxss";

.picker-value {
  display: flex;
  align-items: center;
}
.placeholder {
  color: var(--c-muted);
}

.time-row {
  display: flex;
  gap: 16rpx;
}
.time-row picker {
  flex: 1;
}

.chip-meta {
  margin-left: 10rpx;
  font-size: 22rpx;
  opacity: 0.7;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.stepper-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--c-card);
  border: 2rpx solid var(--c-line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--c-primary-deep);
}
.stepper-value {
  min-width: 48rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}

.submit {
  margin-top: 40rpx;
}
.back-link {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--c-muted);
}
