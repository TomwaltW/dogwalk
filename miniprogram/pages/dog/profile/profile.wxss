/* miniprogram/pages/dog/profile/profile.wxss */
.lost {
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  background: #fff1f0;
  color: #d4380d;
  border-radius: 12rpx;
}

.head {
  padding: 32rpx 0;
  text-align: center;
}

.avatar {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: #eee;
}

.avatar.placeholder {
  line-height: 180rpx;
  font-size: 80rpx;
  display: inline-block;
}

.name {
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 600;
}

.sub {
  font-size: 24rpx;
}

.card {
  padding: 8rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
}

.line {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.line:last-child {
  border-bottom: none;
}

.k {
  width: 160rpx;
  color: #8a8a8a;
}

.v {
  flex: 1;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
}

.tip {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  text-align: center;
}

.primary {
  margin-top: 32rpx;
}
