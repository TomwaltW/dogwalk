/* miniprogram/pages/dog/profile/profile.wxss —— 只写本页特有的,主色与基础类用 app.wxss 的变量 */
.lost {
  background: var(--c-danger-soft);
  color: var(--c-danger);
  border-radius: var(--radius);
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}

.lost-title {
  font-size: 34rpx;
  font-weight: 600;
}

.lost-note {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.head {
  padding: 32rpx 0;
  text-align: center;
}

.head .avatar-lg {
  display: inline-flex;
}

.name {
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 600;
}

.sub {
  font-size: 24rpx;
}

.line {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--c-line);
}

.line:last-child {
  border-bottom: none;
}

.k {
  width: 140rpx;
  color: var(--c-muted);
}

.v {
  flex: 1;
}

.hint {
  font-size: 24rpx;
}

.sent {
  text-align: center;
}

.sent-text {
  font-size: 32rpx;
  color: var(--c-ok);
  padding: 20rpx 0;
}

.block {
  display: block;
  margin-top: 24rpx;
}
