<view class="container">
  <view wx:if="{{loading}}" class="empty">读身份牌中…</view>

  <block wx:elif="{{!dog}}">
    <view class="banner-err">{{errMsg}}</view>
    <view class="empty">下拉可以再试一次</view>
  </block>

  <block wx:else>
    <view wx:if="{{showLostBanner}}" class="lost">
      <view class="lost-title">{{lostTitle}}</view>
      <view wx:if="{{dog.lostNote}}" class="lost-note">{{dog.lostNote}}</view>
    </view>

    <view class="head">
      <image
        wx:if="{{dog.avatarFileID}}"
        class="avatar avatar-lg"
        src="{{dog.avatarFileID}}"
        mode="aspectFill"
        bindtap="onPreviewAvatar"
      />
      <view wx:else class="avatar avatar-lg avatar-blank">🐶</view>
      <view class="name">{{dog.name}}</view>
      <view wx:if="{{dog.breed}}" class="muted sub">{{dog.breed}}</view>
    </view>

    <view class="card">
      <view class="line"><text class="k">体型</text><text class="v">{{view.sizeText}}</text></view>
      <view class="line"><text class="k">性别</text><text class="v">{{view.genderText}}</text></view>
      <view wx:if="{{dog.birthMonth}}" class="line"><text class="k">出生</text><text class="v">{{dog.birthMonth}}</text></view>
      <view wx:if="{{view.tagsText}}" class="line"><text class="k">性格</text><text class="v">{{view.tagsText}}</text></view>
    </view>

    <view wx:if="{{errMsg}}" class="banner-err">{{errMsg}}</view>

    <view wx:if="{{sent}}" class="card sent">
      <view class="sent-text">{{sentText}}</view>
      <button class="btn-ghost block" bindtap="onAgain">再留一条</button>
    </view>

    <view wx:else class="card">
      <view class="section-title">给主人留言</view>
      <view class="field">
        <textarea
          class="textarea"
          value="{{message}}"
          maxlength="{{messageMax}}"
          placeholder="例:它在城北公园西门的长椅下,我先看着"
          bindinput="onMessageInput"
        />
      </view>
      <view class="field row">
        <text class="label">附上我的位置</text>
        <switch color="#ff8a3d" checked="{{attachLocation}}" bindchange="onToggleLocation" />
      </view>
      <view class="muted hint">{{formHint}}</view>
      <button class="btn-primary block" loading="{{submitting}}" bindtap="onSubmit">发送</button>
    </view>
  </block>
</view>
<privacy-popup id="privacy-popup" />
