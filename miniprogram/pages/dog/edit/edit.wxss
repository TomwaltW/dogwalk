/* miniprogram/pages/dog/edit/edit.wxss */
.banner {
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  background: #fff2e8;
  border-radius: 12rpx;
}

.field {
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 12rpx;
}

.field.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label {
  display: block;
  margin-bottom: 8rpx;
  color: #8a8a8a;
  font-size: 24rpx;
}

.field.row .label {
  margin-bottom: 0;
}

.input,
.picked {
  height: 64rpx;
  line-height: 64rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  padding: 8rpx 24rpx;
  margin: 8rpx 12rpx 0 0;
  border: 1rpx solid #d9d9d9;
  border-radius: 999rpx;
  color: #8a8a8a;
}

.chip.on {
  border-color: #1a1a1a;
  color: #1a1a1a;
}

.code {
  font-family: ui-monospace, Menlo, monospace;
  letter-spacing: 4rpx;
}

.qr {
  width: 320rpx;
  margin-top: 16rpx;
}

.primary,
.danger,
.ghost {
  margin-top: 24rpx;
}

.danger {
  color: #d4380d;
}
