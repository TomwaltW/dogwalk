<view class="container">
  <view wx:if="{{errMsg}}" class="banner-err">{{errMsg}}</view>
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:else>
    <!-- 照片 -->
    <view class="card avatar-card">
      <image
        wx:if="{{dog.avatarFileID}}"
        class="avatar avatar-lg"
        src="{{dog.avatarFileID}}"
        mode="aspectFill"
        bindtap="onPreviewAvatar"
      />
      <view wx:else class="avatar avatar-lg avatar-blank">🐶</view>
      <button class="btn-ghost btn-sm" loading="{{uploading}}" bindtap="onChooseAvatar">
        {{uploading ? '上传中…' : (dog.avatarFileID ? '换一张照片' : '传一张照片')}}
      </button>
    </view>

    <view class="card">
      <view class="field">
        <text class="label">名字 <text class="muted">{{view.nameLen}}/{{limits.name}}</text></text>
        <input
          class="input"
          value="{{dog.name}}"
          maxlength="{{limits.name}}"
          placeholder="最多 {{limits.name}} 个字"
          data-field="name"
          bindinput="onFieldInput"
        />
      </view>

      <view class="field">
        <text class="label">品种 <text class="muted">{{view.breedLen}}/{{limits.breed}}</text></text>
        <input
          class="input"
          value="{{dog.breed}}"
          maxlength="{{limits.breed}}"
          placeholder="柴犬、串串…随便写"
          data-field="breed"
          bindinput="onFieldInput"
        />
      </view>

      <view class="field">
        <text class="label">性别</text>
        <picker
          range="{{genderOptions}}"
          range-key="label"
          data-field="gender"
          data-options="genderOptions"
          bindchange="onPickerChange"
        >
          <view class="input picked">{{view.genderText}}</view>
        </picker>
      </view>

      <view class="field">
        <text class="label">出生年月</text>
        <input
          class="input"
          value="{{dog.birthMonth}}"
          maxlength="7"
          placeholder="2023-05,不填也行"
          data-field="birthMonth"
          bindinput="onFieldInput"
        />
      </view>

      <view class="field">
        <text class="label">体型</text>
        <picker
          range="{{sizeOptions}}"
          range-key="label"
          data-field="sizeClass"
          data-options="sizeOptions"
          bindchange="onPickerChange"
        >
          <view class="input picked">{{view.sizeText}}</view>
        </picker>
      </view>

      <view class="field row">
        <text class="label">已绝育</text>
        <switch color="#ff8a3d" checked="{{dog.neutered}}" data-field="neutered" bindchange="onFieldInput" />
      </view>

      <view class="field row">
        <text class="label">疫苗齐全</text>
        <switch color="#ff8a3d" checked="{{dog.vaccinated}}" data-field="vaccinated" bindchange="onFieldInput" />
      </view>

      <view class="field">
        <text class="label">犬证号 <text class="muted">选填 {{view.licenseLen}}/{{limits.license}}</text></text>
        <input
          class="input"
          value="{{dog.licenseNo}}"
          maxlength="{{limits.license}}"
          placeholder="办过犬证就填上,方便走失时核对"
          data-field="licenseNo"
          bindinput="onFieldInput"
        />
      </view>

      <view class="field">
        <text class="label">性格标签 <text class="muted">别人在公园里遇到你家狗时会看到</text></text>
        <view class="chips">
          <view
            wx:for="{{tagOptions}}"
            wx:key="value"
            class="chip {{view.tagChecked[item.value] ? 'chip-on' : ''}}"
            data-value="{{item.value}}"
            bindtap="onToggleTag"
          >{{item.label}}</view>
        </view>
      </view>
    </view>

    <button wx:if="{{!isNew}}" class="btn-ghost block" bindtap="onOpenTag">身份牌与走失模式</button>
    <button class="btn-primary block" loading="{{saving}}" bindtap="onSave">保存</button>
    <button wx:if="{{!isNew}}" class="btn-danger block" bindtap="onRemove">删掉这只狗</button>
  </block>
</view>
<privacy-popup id="privacy-popup" />
